# AnySchool API — environment template
#
# Local dev: copy to api/.env.
# Coolify: set every value below in the service's "Environment Variables"
# panel — the container does NOT read .env files, only real environment vars.
# Values marked (required) must be set or the API misbehaves/fails to boot.

# ─── Database ───────────────────────────────────────────────────────────────
# Neon PostgreSQL. Use the direct (non-pooled) endpoint for this long-running
# container; the API manages its own WebSocket pool.
DATABASE_URL=(required) postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/DBNAME?sslmode=require
# Present in your current .env but unused by the API — no need to set it:
# DATABASE_URL_POOLED=

# ─── Server / network ──────────────────────────────────────────────────────
# Coolify assigns/keeps 3000 by default; override only if you change the port.
PORT=3000
NODE_ENV=production

# Canonical web origin — used for Paystack callback URLs AND allowed by CORS.
WEB_ORIGIN=(required in prod) https://your-web-domain.com
# Extra browser origins allowed by CORS, comma-separated:
CORS_ORIGINS=https://admin.example.com,https://app.example.com
# Always allowed automatically (no config needed):
#   tauri://localhost, https://tauri.localhost   (Tauri desktop client)
#   http://localhost:<any>, http://127.0.0.1:<any> (local dev / preview)

# ─── Paystack ───────────────────────────────────────────────────────────────
# Webhooks fail closed (401) without this key.
PAYSTACK_SECRET_KEY=(required for payments) sk_live_xxx   # or sk_test_xxx
#
# Paystack Dashboard → Settings → API Keys & Webhooks → Webhook URL:
#   https://YOUR-API-DOMAIN/api/payments/webhook
# Route receives the raw body and verifies x-paystack-signature
# (HMAC-SHA512) before parsing — no extra config needed.

# ─── Clerk auth ─────────────────────────────────────────────────────────────
# Required when ANYSCHOOL_AUTH_ENABLED=true (auth is currently off).
CLERK_SECRET_KEY=sk_live_xxx
CLERK_PUBLISHABLE_KEY=pk_live_xxx
# Comma-separated browser origins Clerk tokens are accepted from.
# Defaults to http://localhost:5174 + http://127.0.0.1:5174 when unset.
CLERK_AUTHORIZED_PARTIES=https://your-web-domain.com,http://localhost:5174

# Auth toggle — false = every request runs as the dev user, no token needed.
ANYSCHOOL_AUTH_ENABLED=false
ANYSCHOOL_DEFAULT_SCHOOL_ID=88374870-9175-4565-a876-f17c2e295519

# ─── Cloudflare R2 file storage (optional) ──────────────────────────────────
# If unset, uploads fall back to base64 inside Postgres (not recommended).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CLOUDFLARE_PUBLIC_DOMAIN=
# R2_ENDPOINT=     # optional; derived from the account id when empty
