{
  "name": "anyschool-app",
  "version": "1.0.0",
  "description": "Multi-tenant school management platform",
  "private": true,
  "workspaces": [
    "api",
    "shared",
    "drizzle",
    "web"
  ],
  "scripts": {
    "dev:api": "cd api && npm run dev",
    "dev:web": "cd web && npm run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "db:generate": "cd drizzle && npm run db:generate",
    "db:migrate": "cd drizzle && npm run db:migrate",
    "db:push": "cd drizzle && npm run db:push"
  },
  "keywords": [],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.0"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@tanstack/react-query": "^5.102.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "recharts": "^3.10.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
