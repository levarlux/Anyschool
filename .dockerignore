.git
.gitignore
.agents
.claude
.freebuff
skills
skills-lock.json

# Tauri desktop shell — not part of the API image (huge Rust target dir)
src-tauri

# Logs and scratch files
**/*.log
**/*.pid
*.bat
.DS_Store
